# Secret key used to encrypt stored DB credentials when KMS_PROVIDER=local
# (the default - see app/security/secrets.py) and, unless JWT_SECRET_KEY is
# set separately below, to sign session tokens too. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=change-me-generate-a-real-fernet-key

# Optional - a separate secret for signing session tokens, so it can be
# rotated independently of the credential-encryption key above (rotating
# this one logs everyone out; rotating the credential key doesn't). Falls
# back to APP_SECRET_KEY if left unset. Generate the same way as above.
JWT_SECRET_KEY=

# Optional - a THIRD secret, just for internal platform-staff sessions
# (app/security/platform_auth.py). Falls back to JWT_SECRET_KEY, then
# APP_SECRET_KEY, if unset - strongly recommended to set this separately
# in production, since this is the highest-privilege surface in the app.
PLATFORM_JWT_SECRET=

# Credential encryption backend (app/security/secrets.py). "local" (default)
# uses APP_SECRET_KEY directly - fine for dev. "aws" switches to envelope
# encryption via AWS KMS for production - see docs/CLOUD_KMS.md before
# setting this to "aws".
KMS_PROVIDER=local
AWS_KMS_KEY_ID=
AWS_REGION=us-east-1

# App's own metadata store (tenants, connections, audit log, policies) - NOT customer data
METADATA_DB_URL=sqlite:///./metadata.db

# Anthropic API key - used ONLY for SQL generation & insight explanation.
# The model never receives raw customer credentials or unaggregated raw tables.
ANTHROPIC_API_KEY=sk-ant-xxxx

# CORS origin for the Next.js frontend
FRONTEND_ORIGIN=http://localhost:3000

# Default guardrails
DEFAULT_ROW_LIMIT=1000
QUERY_TIMEOUT_SECONDS=15

# /ask/stream rate & concurrency limits (in-process only — see
# app/security/rate_limit.py for what that means behind multiple workers)
ASK_RATE_LIMIT_PER_USER_PER_MINUTE=10
ASK_MAX_CONCURRENT_PER_TENANT=3

# How long an identical fresh (non-follow-up) question's result is reused
# from cache before it's considered stale (see app/agents/query_cache.py)
ASK_CACHE_TTL_SECONDS=300

# Billing (app/billing/paystack.py) - premium-from-onset: charged
# immediately on subscribe, self-serve full refund within
# BILLING_REFUND_WINDOW_DAYS. Get these from your Paystack dashboard
# (Settings > API Keys & Webhooks for the secret/public keys, Products >
# Plans for the plan code). Set the webhook URL in that same dashboard to
# https://<your-backend-domain>/billing/webhook.
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx
PAYSTACK_PLAN_CODE=PLN_xxxx
# Smallest currency unit (kobo for NGN, cents for USD, pesewas for GHS) -
# must match the plan's real price in the Paystack dashboard exactly.
PAYSTACK_PLAN_AMOUNT=0
BILLING_REFUND_WINDOW_DAYS=7
