# Secret key used to encrypt stored DB credentials when KMS_PROVIDER=local
# (the default - see app/security/secrets.py) and, unless JWT_SECRET_KEY is
# set separately below, to sign session tokens too. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=change-me-generate-a-real-fernet-key

# Optional - a separate secret for signing session tokens, so it can be
# rotated independently of the credential-encryption key above (rotating
# this one logs everyone out; rotating the credential key doesn't). Falls
# back to APP_SECRET_KEY if left unset. Generate the same way as above.
JWT_SECRET_KEY=

# Optional - a THIRD secret, just for internal platform-staff sessions
# (app/security/platform_auth.py). Falls back to JWT_SECRET_KEY, then
# APP_SECRET_KEY, if unset - strongly recommended to set this separately
# in production, since this is the highest-privilege surface in the app.
PLATFORM_JWT_SECRET=

# Credential encryption backend (app/security/secrets.py). "local" (default)
# uses APP_SECRET_KEY directly - fine for dev. "aws" switches to envelope
# encryption via AWS KMS for production - see docs/CLOUD_KMS.md before
# setting this to "aws".
KMS_PROVIDER=local
AWS_KMS_KEY_ID=
AWS_REGION=us-east-1

# App's own metadata store (tenants, connections, audit log, policies) - NOT customer data
METADATA_DB_URL=sqlite:///./metadata.db

# Anthropic API key - used ONLY for SQL generation & insight explanation.
# The model never receives raw customer credentials or unaggregated raw tables.
ANTHROPIC_API_KEY=sk-ant-xxxx

# CORS origin(s) for the Next.js frontend - comma-separated if you need
# more than one allowed (e.g. a real custom domain plus the platform's
# own auto-generated fallback URL). A single value works exactly as before.
FRONTEND_ORIGIN=http://localhost:3000

# Optional - a regex tested against the request's Origin header, checked
# ALONGSIDE FRONTEND_ORIGIN above (either matching is enough), for
# origins that can't be listed individually - specifically per-tenant
# subdomains (app/tenant_slug.py), which are created dynamically and can
# never all be enumerated in FRONTEND_ORIGIN. Leave blank to disable
# (the default) - subdomain logins would otherwise fail with a CORS error
# despite the backend's own login boundary working correctly. Example for
# a real deployment:
# FRONTEND_ORIGIN_REGEX=https://([a-z0-9-]+\.)?getmeridiananalytics\.com
FRONTEND_ORIGIN_REGEX=

# Default guardrails
DEFAULT_ROW_LIMIT=1000
QUERY_TIMEOUT_SECONDS=15

# Shared backing store for the Ask rate/concurrency limits, login cooldown,
# and query result cache below - see app/security/redis_client.py. Leave
# unset for local dev / a single instance: each falls back to in-process
# memory automatically, no behavior change. Set to a real Redis URL
# (redis://... or rediss://... for TLS) once running more than one backend
# instance/replica, so these are genuinely global instead of each replica
# enforcing its own independent limit.
REDIS_URL=

# /ask/stream rate & concurrency limits (in-process by default, genuinely
# global across instances if REDIS_URL is set — see app/security/rate_limit.py)
ASK_RATE_LIMIT_PER_USER_PER_MINUTE=10
ASK_MAX_CONCURRENT_PER_TENANT=3

# How long an identical fresh (non-follow-up) question's result is reused
# from cache before it's considered stale (see app/agents/query_cache.py)
ASK_CACHE_TTL_SECONDS=300

# Login cooldown / brute-force protection on /auth/login and
# /platform/login (in-process by default, genuinely global across
# instances if REDIS_URL is set — see app/security/login_cooldown.py).
# Deliberately generous: this many wrong passwords cost nothing at all
# before any delay kicks in, and delays only ever slow an account down,
# never lock it out permanently.
LOGIN_FREE_ATTEMPTS=5
LOGIN_COOLDOWN_BASE_SECONDS=15
LOGIN_COOLDOWN_MAX_SECONDS=900
LOGIN_COOLDOWN_RESET_AFTER_SECONDS=1800

# Billing (app/billing/paystack.py, app/billing/plans.py) -
# premium-from-onset: charged immediately on subscribe, self-serve full
# refund within BILLING_REFUND_WINDOW_DAYS. Get the secret/public keys
# from Paystack dashboard > Settings > API Keys & Webhooks; set the
# webhook URL there to https://<your-backend-domain>/billing/webhook.
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx
BILLING_REFUND_WINDOW_DAYS=7

# Three separate Paystack Plan objects (dashboard > Products > Plans) -
# Paystack's own model is one price per plan, so Basic/Pro/Premium each
# need their own plan code there, not one plan reused at three prices.
# Amount is the smallest currency unit (kobo for NGN) and must match each
# plan's real price in the dashboard exactly - the defaults below are
# NGN 5,000 / 9,999 / 25,000. Leave a plan's code blank to leave it
# unconfigured - GET /billing/plans reports it as such and /billing/subscribe
# refuses to start checkout for it, rather than failing confusingly deep
# into a Paystack call.
PAYSTACK_PLAN_CODE_BASIC=PLN_xxxx
PAYSTACK_PLAN_AMOUNT_BASIC=500000
PAYSTACK_PLAN_CODE_PRO=PLN_xxxx
PAYSTACK_PLAN_AMOUNT_PRO=999900
PAYSTACK_PLAN_CODE_PREMIUM=PLN_xxxx
PAYSTACK_PLAN_AMOUNT_PREMIUM=2500000

# OCR for scanned/image-only PDF pages (app/agents/document_intelligence.py)
# - only needed to override where Tesseract's binary lives. Production
# (backend/Dockerfile) installs it via apt and needs no override at all;
# this is for local dev on a machine where Tesseract isn't on PATH (a
# common case on Windows, where the installer doesn't always add itself
# to an already-open shell's PATH). See docs/OCR.md.
TESSERACT_CMD=

# Email delivery (app/agents/email_delivery.py). "console" (default) logs
# instead of sending - fine for dev, means nothing here needs to be set.
# "smtp" sends for real via any SMTP-compatible provider - Gmail (an app
# password, not your real password - see myaccount.google.com/apppasswords),
# a transactional provider's SMTP relay (Postmark/SendGrid/SES all have
# one), or your own domain's mail hosting.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional - defaults to SMTP_USERNAME if left blank (the common case:
# the SMTP auth username IS the address you're sending as).
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# Externally-anchored audit checkpoints (app/audit/anchor.py) - fixes the
# one thing the hash-chained audit log's own docstring calls out as
# unfixed: its tamper-evidence lives entirely inside this app's own
# database. Publishing a checkpoint (POST /platform/audit/checkpoint,
# owner-only) commits every tenant's current chain head to a real GitHub
# repo, external to this database entirely. Leave blank to disable the
# feature - nothing else in the app depends on it.
#
# The token needs a fine-grained personal access token (github.com/settings/
# personal-access-tokens) scoped to ONLY the target repo, with Contents:
# Read and write permission - nothing broader. Writes go to a dedicated
# branch (not main - see AUDIT_ANCHOR_GITHUB_BRANCH), created
# automatically on first publish, specifically so this works even on a
# repo with PR-required branch protection on its default branch.
AUDIT_ANCHOR_GITHUB_TOKEN=
AUDIT_ANCHOR_GITHUB_REPO=
AUDIT_ANCHOR_GITHUB_PATH=audit_checkpoints.jsonl
AUDIT_ANCHOR_GITHUB_BRANCH=audit-checkpoints
